rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // No-deletes policy: creates/updates are allowed for signed-in users,
    // deletes are blocked everywhere. A user may only write their own
    // /users doc; shared game data is writable by any signed-in player.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /tournaments/{tournamentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    match /games/{gameId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    match /renegs/{renegId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    match /rules/{ruleId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    match /claysMatches/{matchId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // clayScores allows delete: the app's "Undo last presentation" feature
    // (services/claysService.ts deleteLastScoreForMatch) does a real delete here,
    // unlike every other collection — see the flagged policy conflict with the
    // README's No-Deletes policy.
    match /clayScores/{scoreId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Everything else: deny by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
