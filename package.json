{
  "name": "core-score",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "build:web": "npx expo export --platform web",
    "build:web:copy": "npm run build:web && node ./scripts/copy-thumbnail.js",
    "predeploy": "npm run build:web:copy",
    "deploy": "npm run build:web:copy && npx firebase-tools deploy --only hosting",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "backfill:tournaments": "node ./scripts/backfill-tournaments.js",
    "backfill:rules": "node ./scripts/backfill-rules-tournament.js",
    "audit:data": "node ./scripts/audit-production-data.js",
    "audit:data:backup": "node ./scripts/audit-production-data.js backups/20260701T212256",
    "backup": "node ./scripts/export/export-firestore.js",
    "backup:auth": "INCLUDE_AUTH=true node ./scripts/export/export-firestore.js",
    "backup:lite": "STRIP_PHOTOS=true node ./scripts/export/export-firestore.js",
    "restore": "node ./scripts/export/restore-firestore.js",
    "restore:dry": "DRY_RUN=true node ./scripts/export/restore-firestore.js",
    "emulators": "npx firebase-tools emulators:start --only firestore,auth",
    "dev:seed": "USE_EMULATOR=true node ./scripts/dev/seed-emulator.js",
    "dev:seed:mock": "USE_EMULATOR=true node ./scripts/dev/seed-mock-only.js",
    "dev:auth-helper": "node ./scripts/dev/dev-auth-server.js",
    "dev:test:visibility": "USE_EMULATOR=true node ./scripts/dev/test-tournament-visibility.js",
    "dev:test:create-tournament": "USE_EMULATOR=true node ./scripts/dev/test-create-tournament.js",
    "dev:test:alex-kim": "USE_EMULATOR=true node ./scripts/dev/test-alex-kim-flow.js",
    "dev:web": "EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true expo start --web",
    "dev:web:full": "bash ./scripts/dev/start-local.sh",
    "dev:local": "bash ./scripts/dev/start-local.sh"
  },
  "importScripts": {
    "import:dry": "DRY_RUN=true node ./scripts/import/import-data.js",
    "import:run": "node ./scripts/import/import-data.js",
    "import:photos": "node ./scripts/import/import-photos.js",
    "import:rules": "node ./scripts/import/import-rules.js",
    "import:clear": "node ./scripts/import/clear-data.js",
    "import:refresh": "node ./scripts/import/refresh-imports.js",
    "import:clear-games": "node ./scripts/import/clear-games.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.37",
    "expo-auth-session": "~7.0.11",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "firebase": "^12.7.0",
    "firebase-admin": "^13.6.0",
    "fuse.js": "^6.6.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "victory-native": "^36.9.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.12",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "jscpd": "^5.1.2",
    "madge": "^8.0.0",
    "react-test-renderer": "^19.1.0",
    "sharp": "^0.34.5",
    "ts-prune": "^0.10.3",
    "typescript": "~5.9.2"
  },
  "private": true
}
